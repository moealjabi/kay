{
  "name": "@kayona/plugin-cloud",
  "version": "5.44.0",
  "description": "Instructions to deploy your local project to Kayona Cloud",
  "homepage": "https://kayona.io",
  "bugs": {
    "url": "https://github.com/moealjabi/kay/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moealjabi/kay.git",
    "directory": "packages/plugins/cloud"
  },
  "license": "MIT",
  "author": {
    "name": "Kayona Solutions SAS",
    "email": "hello@kayona.io",
    "url": "https://kayona.io"
  },
  "maintainers": [
    {
      "name": "Kayona Solutions SAS",
      "email": "hello@kayona.io",
      "url": "https://kayona.io"
    }
  ],
  "exports": {
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T rollup -c",
    "build:types": "run -T run-p build:types:admin",
    "build:types:admin": "run -T tsc -p admin/tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "develop": "strapi-plugin watch",
    "lint": "run -T eslint .",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "watch": "run -T rollup -c -w"
  },
  "dependencies": {
    "@kayona/design-system": "2.2.0",
    "@kayona/icons": "2.2.0",
    "react-intl": "6.6.2"
  },
  "devDependencies": {
    "@kayona/admin": "5.44.0",
    "@kayona/strapi": "5.44.0",
    "eslint-config-custom": "5.44.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "styled-components": "6.1.8",
    "tsconfig": "5.44.0",
    "typescript": "5.4.5"
  },
  "peerDependencies": {
    "@kayona/admin": "^5.0.0",
    "@kayona/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "name": "strapi-cloud",
    "description": "Instructions to deploy your local project to Kayona Cloud",
    "kind": "plugin",
    "displayName": "Kayona Cloud"
  }
}
